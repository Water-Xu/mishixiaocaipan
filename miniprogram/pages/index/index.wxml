<view class="page-container">
  <view class="index-page">
    <!-- 标题 -->
    <view class="title-area">
      <text class="title">今天吃什么？</text>
      <text class="subtitle">让骰子帮你做决定</text>
    </view>

    <!-- 骰子区域 -->
    <view class="dice-area">
      <dice-roller
        rolling="{{rolling}}"
        bind:roll="rollDice"
        bind:done="onDiceDone"
      />
      <view wx:if="{{loading}}" class="thinking-bubble">
        <text>🤔 AI 在选最适合你的…</text>
      </view>
    </view>

    <!-- 推荐结果 -->
    <view wx:if="{{result && !loading}}" class="result-card slide-up">
      <view class="result-header" bindtap="goMerchantDetail">
        <image
          wx:if="{{result.merchant.coverImage}}"
          class="result-cover"
          src="{{result.merchant.coverImage}}"
          mode="aspectFill"
        />
        <view wx:else class="result-cover-placeholder">🏪</view>
        <view class="result-info">
          <text class="result-name">{{result.merchant.name}}</text>
          <view class="result-score">
            <text class="score-star">★</text>
            <text class="score-num">{{result.merchant.avgScore || '--'}}</text>
            <text class="score-count">  {{result.merchant.reviewCount || 0}}人评过</text>
          </view>
        </view>
        <view class="result-arrow">›</view>
      </view>

      <!-- AI 推荐理由 -->
      <view class="reason-box">
        <text class="reason-label">为什么推它</text>
        <text class="reason-text">{{result.reason}}</text>
      </view>

      <!-- 标签 -->
      <view wx:if="{{result.tags && result.tags.length}}" class="result-tags">
        <view
          wx:for="{{result.tags}}"
          wx:key="*this"
          class="result-tag {{item.indexOf('⚠️') > -1 ? 'tag-warn' : 'tag-ok'}}"
        >{{item}}</view>
      </view>

      <!-- 操作按钮 -->
      <view class="result-actions">
        <view class="btn-reroll btn-ghost" bindtap="reroll">
          🎲 再摇一次
        </view>
        <view class="btn-confirm btn-primary" bindtap="confirmMerchant">
          就吃这家 ✓
        </view>
      </view>
    </view>

    <!-- 对话式输入 -->
    <view class="chat-area">
      <view class="chat-toggle" bindtap="toggleChat">
        <text>{{chatMode ? '▲ 收起' : '💬 有想法？告诉我'}}</text>
      </view>
      <view wx:if="{{chatMode}}" class="chat-input-wrap fade-in">
        <input
          class="chat-input"
          placeholder="今天想吃软一点的 / 预算只有20块 / 上次那家太辣了…"
          value="{{chatInput}}"
          bindinput="inputChat"
          bindconfirm="sendChat"
        />
        <view class="chat-send" bindtap="sendChat">
          <text>→</text>
        </view>
      </view>
    </view>
  </view>
</view>
