.ranking-page { padding: 0 32rpx 160rpx; }

.ranking-header {
  padding: 56rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.header-title { font-size: 44rpx; font-weight: 800; color: #1C1008; }
.header-sub { font-size: 26rpx; color: #9E9185; }
.share-btn {
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 12rpx 28rpx;
  background: #FFF0ED;
  color: #F54B2A;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.share-btn:active { opacity: 0.7; }

.loading-state { text-align: center; padding: 80rpx; color: #BDB0A0; font-size: 28rpx; }

.rank-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(28,16,8,0.07);
}
.rank-section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.rank-emoji { font-size: 40rpx; }
.rank-title { font-size: 30rpx; font-weight: 700; color: #1C1008; flex: 1; }
.rank-sub { font-size: 22rpx; color: #BDB0A0; }

.rank-list { display: flex; flex-direction: column; gap: 16rpx; }
.rank-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; border-radius: 12rpx; }
.rank-bad { background: #FFF8F5; }
.rank-good { background: #F8FFF8; }
.rank-num { font-size: 36rpx; font-weight: 800; width: 48rpx; text-align: center; flex-shrink: 0; }
.bad-num { color: #F54B2A; }
.good-num { color: #4CAF7D; }
.rank-info { flex: 1; }
.rank-name { font-size: 28rpx; font-weight: 600; color: #1C1008; display: block; margin-bottom: 4rpx; }
.rank-quote { font-size: 22rpx; color: #9E9185; display: block; }
.rank-count { font-size: 24rpx; color: #F54B2A; font-weight: 600; flex-shrink: 0; }
.avg-score { display: flex; align-items: center; gap: 4rpx; flex-shrink: 0; }
.score-val { font-size: 32rpx; font-weight: 700; color: #FFB836; }
.score-star { font-size: 24rpx; color: #FFB836; }

.rank-empty { text-align: center; padding: 32rpx; font-size: 26rpx; color: #BDB0A0; }

.reviewer-card { display: flex; align-items: center; gap: 20rpx; }
.reviewer-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #F5F0EB; }
.reviewer-info { flex: 1; }
.reviewer-name { font-size: 30rpx; font-weight: 600; color: #1C1008; display: block; margin-bottom: 4rpx; }
.reviewer-desc { font-size: 24rpx; color: #9E9185; }
.reviewer-badge { font-size: 48rpx; }

.stats-section {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28,16,8,0.07);
}
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 800; color: #F54B2A; display: block; margin-bottom: 8rpx; }
.stat-label { font-size: 22rpx; color: #9E9185; }
