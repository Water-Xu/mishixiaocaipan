.merchant-header {
  background: #FFFFFF;
  padding-bottom: 24rpx;
}
.header-cover {
  width: 100%;
  height: 360rpx;
  display: block;
}
.header-cover-placeholder {
  width: 100%;
  height: 360rpx;
  background: #FFF0ED;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}
.header-info { padding: 28rpx 32rpx 0; }
.name-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.merchant-name { font-size: 40rpx; font-weight: 800; color: #1C1008; flex: 1; }
.blacklist-tag { font-size: 22rpx; color: #BDB0A0; padding: 4rpx 12rpx; background: #F5F0EB; border-radius: 8rpx; }
.score-row { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; }
.big-score { font-size: 56rpx; font-weight: 800; color: #FFB836; }
.score-label { font-size: 24rpx; color: #9E9185; }
.review-count-badge { font-size: 22rpx; color: #BDB0A0; background: #F5F0EB; padding: 4rpx 16rpx; border-radius: 20rpx; margin-left: auto; }
.sub-row { display: flex; align-items: center; gap: 20rpx; }
.category-label { font-size: 24rpx; color: #7A6858; background: #FFF8F3; padding: 4rpx 16rpx; border-radius: 8rpx; }
.address-text { font-size: 24rpx; color: #BDB0A0; }

.action-bar {
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #F0E5DC;
  margin: 0 0 16rpx;
}
.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  border-right: 1rpx solid #F0E5DC;
  transition: background 0.15s ease;
}
.action-item:last-child { border-right: none; }
.action-item:active { background: #FFF8F3; }
.action-icon { font-size: 40rpx; }
.action-label { font-size: 24rpx; color: #7A6858; }

.reviews-section { padding: 0 32rpx; }
.reviews-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1008;
  display: block;
  padding: 20rpx 0;
}
.reviews-list { display: flex; flex-direction: column; gap: 20rpx; }

.skeleton-header { background: #FFFFFF; padding: 32rpx; }
.skeleton-cover { height: 360rpx; width: 100%; border-radius: 0; }
.skeleton-info { padding: 28rpx 0 0; }
.skeleton-title { height: 44rpx; width: 50%; margin-bottom: 20rpx; }
.skeleton-sub { height: 28rpx; width: 70%; }

.loading-more, .no-more { text-align: center; padding: 32rpx; font-size: 24rpx; color: #BDB0A0; }
