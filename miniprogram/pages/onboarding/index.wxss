.page {
  min-height: 100vh;
  background: #FFF8F3;
  padding: 0 32rpx;
}

/* ── 通用动画 ── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(32rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in  { animation: fadeIn  0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
.slide-up { animation: slideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1) both; }

.step { padding-bottom: 48rpx; margin-top: 150rpx; }

/* ── Hero ── */
.step-0 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}
.logo-emoji {
  font-size: 120rpx;
  line-height: 1.2;
  margin-bottom: 20rpx;
  animation: fadeIn 0.5s 0.1s both;
}
.app-name {
  font-size: 52rpx;
  font-weight: 800;
  color: #1C1008;
  letter-spacing: -1rpx;
  margin-bottom: 16rpx;
  animation: fadeIn 0.5s 0.2s both;
}
.app-slogan {
  font-size: 28rpx;
  color: #7A6858;
  text-align: center;
  line-height: 1.6;
  animation: fadeIn 0.5s 0.3s both;
}

/* ── 身份区 ── */
.identity-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1008;
  margin-bottom: 32rpx;
  animation: fadeIn 0.4s 0.35s both;
}

/* 头像 */
.avatar-wrap {
  margin-bottom: 32rpx;
  animation: fadeIn 0.4s 0.4s both;
}
.avatar-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0 auto;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #F54B2A;
}
.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F54B2A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F5EEE9;
  border: 3rpx dashed #D4C5B8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: auto;
  padding: 10rpx;
  gap: 8rpx;
  transition: all 0.2s;
}
.avatar-placeholder:active { transform: scale(0.95); }
.avatar-placeholder-icon { font-size: 60rpx; }
.avatar-placeholder-tip { font-size: 22rpx; color: #BDB0A0; }

/* 昵称输入 */
.nickname-wrap {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 12rpx;
  border: 2rpx solid #F0E5DC;
  transition: border-color 0.2s;
  animation: fadeIn 0.4s 0.45s both;
}
.nickname-wrap.input-error { border-color: #F54B2A; }
.nickname-input {
  height: 96rpx;
  font-size: 32rpx;
  color: #1C1008;
  width: 100%;
}

/* ── 通用输入 ── */
.input-wrap {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 28rpx;
  border: 2rpx solid #F0E5DC;
  transition: border-color 0.2s;
}
.input-wrap.input-error { border-color: #F54B2A; }
.code-input {
  height: 96rpx;
  font-size: 32rpx;
  color: #1C1008;
  width: 100%;
  letter-spacing: 4rpx;
}
.error-text {
  font-size: 24rpx;
  color: #F54B2A;
  display: block;
  margin-top: 12rpx;
  padding-left: 4rpx;
  align-self: flex-start;
}

/* ── 通用按钮 ── */
.action-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  margin-top: 8rpx;
  transition: all 0.15s;
}
.action-btn:active { transform: scale(0.97); }
.btn-loading { opacity: 0.7; }

/* ── Step 1：群组 ── */
.step-1 {
  padding-top: 80rpx;
}
.step-header {
  margin-bottom: 48rpx;
  animation: fadeIn 0.4s 0.1s both;
}
.step-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1C1008;
  display: block;
  margin-bottom: 12rpx;
}
.step-sub {
  font-size: 26rpx;
  color: #7A6858;
}

/* 模式卡片 */
.mode-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  animation: fadeIn 0.4s 0.2s both;
}
.mode-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 36rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 3rpx solid #F0E5DC;
  transition: all 0.25s cubic-bezier(0.34, 1.4, 0.64, 1);
}
.mode-card:active { transform: scale(0.96); }
.mode-card-active {
  border-color: #F54B2A;
  background: #FFF0ED;
  transform: scale(1.03);
  box-shadow: 0 8rpx 24rpx rgba(245,75,42,0.12);
}
.mode-emoji { font-size: 56rpx; }
.mode-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1008;
  text-align: center;
}
.mode-card-active .mode-title { color: #F54B2A; }
.mode-desc {
  font-size: 22rpx;
  color: #BDB0A0;
  text-align: center;
  line-height: 1.4;
}
.mode-card-active .mode-desc { color: #F54B2A; opacity: 0.7; }

/* 群组输入区 */
.group-input-section {
  margin-bottom: 24rpx;
}
.input-label {
  font-size: 26rpx;
  color: #7A6858;
  display: block;
  margin-bottom: 16rpx;
}

/* ── Step 2：偏好 ── */
.step-2 { padding-top: 40rpx; padding-bottom: 200rpx; }

/* 群组成功徽标 */
.company-badge {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #FFF0ED, #FFEEE8);
  border: 2rpx solid #F54B2A;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 40rpx;
  animation: slideUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  box-shadow: 0 4rpx 20rpx rgba(245,75,42,0.1);
}
.company-badge-icon { font-size: 48rpx; flex-shrink: 0; }
.company-badge-info { flex: 1; }
.company-badge-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1008;
  display: block;
  margin-bottom: 4rpx;
}
.company-badge-meta {
  font-size: 22rpx;
  color: #7A6858;
}
.company-badge-code {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.invite-code-label {
  font-size: 20rpx;
  color: #BDB0A0;
}
.invite-code-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #F54B2A;
  letter-spacing: 4rpx;
  background: rgba(245,75,42,0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.onboard-header { margin-bottom: 48rpx; }
.onboard-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1C1008;
  display: block;
  margin-bottom: 12rpx;
}
.onboard-sub { font-size: 26rpx; color: #7A6858; }

.pref-section { margin-bottom: 48rpx; }
.pref-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1008;
  display: block;
  margin-bottom: 8rpx;
}
.pref-sub {
  font-size: 24rpx;
  color: #BDB0A0;
  display: block;
  margin-bottom: 20rpx;
}

.options-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}
.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #F0E5DC;
  transition: all 0.2s cubic-bezier(0.34, 1.4, 0.64, 1);
  width: calc(50% - 16rpx);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.option-item-hover { transform: scale(0.95); opacity: 0.85; }
.option-active {
  border-color: #F54B2A;
  background: #FFF0ED;
  transform: scale(1.02);
}
.option-emoji { font-size: 48rpx; }
.option-label { font-size: 26rpx; font-weight: 500; color: #1C1008; text-align: center; }
.option-active .option-label { color: #F54B2A; font-weight: 700; }

.options-wrap { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.option-tag {
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 2rpx solid #F0E5DC;
  font-size: 26rpx;
  color: #7A6858;
  transition: all 0.15s ease;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.option-tag-hover { transform: scale(0.95); opacity: 0.8; }
.option-tag-active {
  background: #FFF0ED;
  border-color: #F54B2A;
  color: #F54B2A;
  font-weight: 600;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #FFF8F3 60%, transparent);
}
.bottom-btn .btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
}
