<view class="page-container detail-page">
  <view wx:if="{{loading}}" class="detail-skeleton">
    <view class="skeleton skeleton-block"></view>
    <view class="skeleton skeleton-block short"></view>
    <view class="skeleton skeleton-card"></view>
  </view>

  <block wx:elif="{{review}}">
    <view class="detail-body">
      <view wx:if="{{hasOrderInfo}}" class="order-card slide-up">
        <view class="order-card-header">
          <text class="order-card-icon">🧾</text>
          <text class="order-card-title">本单菜品</text>
          <text wx:if="{{review.totalAmountLabel}}" class="order-card-amount">共 {{review.totalAmountLabel}}</text>
        </view>
        <view wx:if="{{orderItems.length > 0}}" class="order-items-row">
          <view
            wx:for="{{orderItems}}"
            wx:key="index"
            class="order-item-chip"
            style="animation-delay: {{index * 0.04}}s"
          >
            <text class="order-item-name">{{item.name}}</text>
            <text wx:if="{{item.price}}" class="order-item-price">¥{{item.price}}</text>
          </view>
        </view>
        <view wx:elif="{{review.totalAmountLabel}}" class="order-only-amount">
          <text>实付 {{review.totalAmountLabel}}</text>
        </view>
      </view>

      <view wx:if="{{review.merchantName}}" class="merchant-card slide-up" bindtap="goMerchant">
        <view class="merchant-card-left">
          <text class="merchant-card-icon">🏪</text>
          <view class="merchant-card-info">
            <text class="merchant-card-name">{{review.merchantName}}</text>
            <text wx:if="{{review.merchantCategory}}" class="merchant-card-meta">{{review.merchantCategory}}</text>
          </view>
        </view>
        <view class="merchant-card-right">
          <text wx:if="{{review.merchantAvgScore}}" class="merchant-card-score">{{review.merchantAvgScore}}</text>
          <text class="merchant-card-arrow">›</text>
        </view>
      </view>

      <view wx:if="{{subScoreList.length > 0}}" class="sub-scores-card slide-up">
        <text class="sub-scores-title">分项评分</text>
        <view class="sub-scores-grid">
          <view
            wx:for="{{subScoreList}}"
            wx:key="key"
            class="sub-score-item"
            style="animation-delay: {{index * 0.05}}s"
          >
            <text class="sub-score-label">{{item.label}}</text>
            <view class="sub-score-stars">
              <text class="sub-star {{item.score >= 1 ? 'sub-star-on' : ''}}">★</text>
              <text class="sub-star {{item.score >= 2 ? 'sub-star-on' : ''}}">★</text>
              <text class="sub-star {{item.score >= 3 ? 'sub-star-on' : ''}}">★</text>
              <text class="sub-star {{item.score >= 4 ? 'sub-star-on' : ''}}">★</text>
              <text class="sub-star {{item.score >= 5 ? 'sub-star-on' : ''}}">★</text>
            </view>
          </view>
        </view>
      </view>

      <view class="review-wrap slide-up">
        <review-card
          review="{{review}}"
          showMerchant="{{false}}"
          linkable="{{false}}"
          defaultExpanded="{{true}}"
          bind:interactionupdate="onReviewInteractionUpdate"
        />
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <text class="empty-icon">😶</text>
    <text class="empty-text">这条评价找不到了</text>
  </view>
</view>
