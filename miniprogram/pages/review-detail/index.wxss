.detail-page {
  padding: 24rpx 32rpx 160rpx;
}

.detail-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.skeleton-block {
  height: 160rpx;
  border-radius: 16rpx;
}
.skeleton-block.short { height: 96rpx; }
.skeleton-card { height: 480rpx; border-radius: 16rpx; }

.detail-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: linear-gradient(135deg, #FFF8F3, #FFF0ED);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #FFD8CC;
  box-shadow: 0 2rpx 16rpx rgba(245, 75, 42, 0.08);
}
.order-card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.order-card-icon { font-size: 30rpx; }
.order-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1008;
  flex: 1;
}
.order-card-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #F54B2A;
}
.order-items-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.order-item-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #7A6858;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid #FFD8CC;
  animation: chipIn 0.35s cubic-bezier(0.34, 1.2, 0.64, 1) both;
}
@keyframes chipIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.order-item-name { font-weight: 500; }
.order-item-price { color: #F54B2A; font-weight: 600; }
.order-only-amount {
  font-size: 26rpx;
  color: #7A6858;
}

.merchant-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 16, 8, 0.07);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.merchant-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(28, 16, 8, 0.1);
}
.merchant-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.merchant-card-icon { font-size: 36rpx; flex-shrink: 0; }
.merchant-card-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.merchant-card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1008;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.merchant-card-meta {
  font-size: 22rpx;
  color: #BDB0A0;
}
.merchant-card-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.merchant-card-score {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFB836;
}
.merchant-card-arrow {
  font-size: 32rpx;
  color: #BDB0A0;
}

.sub-scores-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 16, 8, 0.07);
}
.sub-scores-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1008;
  display: block;
  margin-bottom: 16rpx;
}
.sub-scores-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.sub-score-item {
  background: #FFF8F3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  animation: subScoreIn 0.4s ease both;
}
@keyframes subScoreIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.sub-score-label {
  font-size: 22rpx;
  color: #7A6858;
  display: block;
  margin-bottom: 8rpx;
}
.sub-score-stars { display: flex; gap: 4rpx; }
.sub-star {
  font-size: 24rpx;
  color: #E8DDD5;
  transition: color 0.2s ease;
}
.sub-star-on { color: #FFB836; }

.review-wrap {
  animation-delay: 0.08s;
}
