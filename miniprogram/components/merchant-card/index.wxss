.merchant-card {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 16, 8, 0.07);
  transition: transform 0.15s ease;
}
.merchant-card:active { transform: scale(0.98); }

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F5F0EB;
  flex-shrink: 0;
}
.info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }

.name-row { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 30rpx; font-weight: 600; color: #1C1008; flex: 1; }
.blacklist-badge { font-size: 20rpx; color: #BDB0A0; }

.meta-row { display: flex; align-items: center; justify-content: space-between; }
.score-row { display: flex; align-items: center; gap: 6rpx; }
.score-num { font-size: 32rpx; font-weight: 700; color: #FFB836; }
.score-star { font-size: 24rpx; color: #FFB836; }
.review-count { font-size: 22rpx; color: #BDB0A0; }
.category-tag {
  font-size: 22rpx;
  color: #7A6858;
  background: #F5F0EB;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
