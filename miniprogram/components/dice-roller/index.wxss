.dice-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  cursor: pointer;
  user-select: none;
}
.dice-face {
  font-size: 160rpx;
  line-height: 1;
  display: block;
  transition: transform 0.1s ease;
  filter: drop-shadow(0 8rpx 24rpx rgba(245, 75, 42, 0.25));
}
.dice-hint-text {
  font-size: 26rpx;
  color: #BDB0A0;
  font-weight: 400;
}

/* 滚动动画 */
.rolling .dice-face {
  animation: diceRoll 0.12s linear infinite;
}
@keyframes diceRoll {
  0% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(15deg) scale(1.1); }
  50% { transform: rotate(0deg) scale(0.95); }
  75% { transform: rotate(-15deg) scale(1.1); }
  100% { transform: rotate(0deg) scale(1); }
}

/* 落地弹跳 */
.bounce .dice-face {
  animation: diceBounce 0.4s cubic-bezier(0.34, 1.6, 0.64, 1) both;
}
@keyframes diceBounce {
  0% { transform: scale(1.4); }
  60% { transform: scale(0.9); }
  100% { transform: scale(1); }
}
