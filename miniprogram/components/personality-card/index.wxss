.personality-card {
  cursor: pointer;
  transition: transform 0.2s ease;
}
.personality-card:active { transform: scale(0.97); }
.card-bg {
  background: linear-gradient(135deg, #F54B2A, #FF8C42);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  overflow: hidden;
}
.card-bg::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}
.big-emoji {
  font-size: 80rpx;
  line-height: 1;
  flex-shrink: 0;
}
.card-text { flex: 1; }
.personality-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}
.nickname-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
}
.share-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  position: absolute;
  bottom: 20rpx;
  right: 28rpx;
}
