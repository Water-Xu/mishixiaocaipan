.review-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 16, 8, 0.07);
  animation: slideUp 0.35s cubic-bezier(0.34, 1.2, 0.64, 1) both;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.review-card:active {
  transform: scale(0.995);
}
.review-card-static:active {
  transform: none;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F5F0EB;
}
.avatar-img {
  animation: avatarPop 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) both;
}
@keyframes avatarPop {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}
.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE0D5, #FFD0C0);
}
.avatar-default-emoji {
  font-size: 44rpx;
  line-height: 1;
}
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1008;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.second-badge {
  font-size: 20rpx;
  color: #FF8C42;
  background: #FFF3E8;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.time {
  font-size: 22rpx;
  color: #BDB0A0;
}

.score-badge {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.score-badge.score-good { background: #EDF7F1; }
.score-badge.score-bad { background: #FFF0ED; }
.score-badge.score-mid { background: #FFF8EE; }
.score-num { font-size: 28rpx; font-weight: 700; }
.score-star { font-size: 24rpx; }
.score-good .score-num, .score-good .score-star { color: #4CAF7D; }
.score-bad .score-num, .score-bad .score-star { color: #F54B2A; }
.score-mid .score-num, .score-mid .score-star { color: #FFB836; }

.merchant-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 10rpx 16rpx;
  background: #FFF8F3;
  border-radius: 8rpx;
}
.merchant-icon { font-size: 24rpx; }
.merchant-name { font-size: 24rpx; color: #7A6858; flex: 1; }
.merchant-arrow { font-size: 28rpx; color: #BDB0A0; }

.content-wrap { margin-bottom: 16rpx; }
.content {
  font-size: 28rpx;
  color: #1C1008;
  line-height: 1.7;
}
.expand-btn {
  font-size: 26rpx;
  color: #F54B2A;
  font-weight: 500;
}

.images-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.review-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.tag-bad { background: #FFF0ED; color: #F54B2A; }
.tag-good { background: #EDF7F1; color: #4CAF7D; }

.mood-text {
  font-size: 22rpx;
  color: #BDB0A0;
  margin-top: 8rpx;
}

.interaction-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E8E0;
}
.inter-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  background: #FFF8F3;
  transition: transform 0.15s ease, background 0.2s ease;
  animation: interFade 0.45s ease both;
}
.inter-btn:active {
  transform: scale(0.96);
}
.inter-btn.inter-disabled {
  opacity: 0.55;
  pointer-events: none;
}
.inter-like.inter-liked {
  background: #FFE8EC;
}
.inter-challenge {
  background: #FFF0ED;
}
@keyframes interFade {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.inter-icon { font-size: 28rpx; line-height: 1; }
.inter-label { font-size: 24rpx; color: #7A6858; font-weight: 500; }
.inter-count { font-size: 22rpx; color: #BDB0A0; }

.interaction-thread {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #FAFAF8;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.thread-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  animation: threadIn 0.35s ease both;
}
@keyframes threadIn {
  from { opacity: 0; transform: translateX(-6rpx); }
  to { opacity: 1; transform: translateX(0); }
}
.thread-name { color: #F54B2A; font-weight: 600; }
.thread-time { color: #BDB0A0; font-size: 20rpx; }
.thread-text {
  flex: 1 0 100%;
  color: #4A4038;
  word-break: break-all;
}

.challenge-thread {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF5F2;
  border-radius: 12rpx;
  border: 1rpx solid #FFD6CC;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.challenge-badge {
  font-size: 20rpx;
  color: #fff;
  background: #F54B2A;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.challenge-row .thread-name { color: #C62828; }
