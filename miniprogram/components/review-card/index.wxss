.review-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 16, 8, 0.07);
  animation: slideUp 0.35s cubic-bezier(0.34, 1.2, 0.64, 1) both;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F5F0EB;
}
.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE0D5, #FFD0C0);
}
.avatar-default-emoji {
  font-size: 44rpx;
  line-height: 1;
}
.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1008;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.second-badge {
  font-size: 20rpx;
  color: #FF8C42;
  background: #FFF3E8;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.time {
  font-size: 22rpx;
  color: #BDB0A0;
}

.score-badge {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}
.score-badge.score-good { background: #EDF7F1; }
.score-badge.score-bad { background: #FFF0ED; }
.score-badge.score-mid { background: #FFF8EE; }
.score-num { font-size: 28rpx; font-weight: 700; }
.score-star { font-size: 24rpx; }
.score-good .score-num, .score-good .score-star { color: #4CAF7D; }
.score-bad .score-num, .score-bad .score-star { color: #F54B2A; }
.score-mid .score-num, .score-mid .score-star { color: #FFB836; }

.merchant-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 10rpx 16rpx;
  background: #FFF8F3;
  border-radius: 8rpx;
}
.merchant-icon { font-size: 24rpx; }
.merchant-name { font-size: 24rpx; color: #7A6858; flex: 1; }
.merchant-arrow { font-size: 28rpx; color: #BDB0A0; }

.content-wrap { margin-bottom: 16rpx; }
.content {
  font-size: 28rpx;
  color: #1C1008;
  line-height: 1.7;
}
.expand-btn {
  font-size: 26rpx;
  color: #F54B2A;
  font-weight: 500;
}

.images-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.review-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.tag-bad { background: #FFF0ED; color: #F54B2A; }
.tag-good { background: #EDF7F1; color: #4CAF7D; }

.mood-text {
  font-size: 22rpx;
  color: #BDB0A0;
  margin-top: 8rpx;
}
