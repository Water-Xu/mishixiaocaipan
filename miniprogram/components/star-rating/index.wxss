.star-wrap {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.star {
  line-height: 1;
  transition: transform 0.1s ease;
}
.star.clickable:active {
  transform: scale(1.3);
}
.star.full .star-char { color: #FFB836; }
.star.empty .star-char { color: #DDD4CC; }

.star-normal .star-char { font-size: 36rpx; }
.star-large .star-char { font-size: 52rpx; }
.star-small .star-char { font-size: 24rpx; }
