.img-wrap {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F0EB;
  flex-shrink: 0;
}
.img {
  width: 100%;
  height: 100%;
  display: block;
  transition: opacity 0.3s ease;
}
.img-pending {
  opacity: 0.5;
  filter: blur(2px);
}
.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 16, 8, 0.3);
}
.overlay-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.rejected-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F0EB;
  gap: 8rpx;
}
.rejected-icon { font-size: 36rpx; }
.rejected-text { font-size: 20rpx; color: #BDB0A0; }
