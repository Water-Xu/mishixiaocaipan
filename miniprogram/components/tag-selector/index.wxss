.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}
.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #F5F0EB;
  color: #7A6858;
  border: 2rpx solid transparent;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.tag-item-hover {
  transform: scale(0.95);
  opacity: 0.85;
}
.tag-active {
  background: #FFF0ED;
  color: #F54B2A;
  border-color: #F54B2A;
  font-weight: 600;
}
