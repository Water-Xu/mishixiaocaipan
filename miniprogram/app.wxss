/* 全局主题色变量 */
page {
  --color-primary: #F54B2A;
  --color-primary-light: #FFF0ED;
  --color-primary-dark: #D63A1E;
  --color-orange: #FF8C42;
  --color-green: #4CAF7D;
  --color-green-light: #EDF7F1;
  --color-yellow: #FFB836;
  --color-red-light: #FFF0ED;

  --color-bg: #FFF8F3;
  --color-surface: #FFFFFF;
  --color-surface-2: #FFF4EE;
  --color-border: #F0E5DC;

  --color-text: #1C1008;
  --color-text-2: #7A6858;
  --color-text-3: #BDB0A0;

  --shadow-card: 0 2px 16px rgba(28, 16, 8, 0.07);
  --shadow-float: 0 8px 32px rgba(28, 16, 8, 0.12);
  --radius-card: 16rpx;
  --radius-btn: 48rpx;
  --radius-tag: 8rpx;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 基础重置（WXSS 不支持 * 通配符，在 page 里统一设置） */

/* 通用卡片 */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.15s ease;
  border: none;
  outline: none;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
}
.btn-primary:active {
  background: var(--color-primary-dark);
  transform: scale(0.97);
}
.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
.btn-ghost:active {
  background: var(--color-primary-light);
}
.btn-disabled {
  background: #E8DDD5;
  color: var(--color-text-3);
}

/* 通用标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  font-weight: 500;
}
.tag-red {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.tag-green {
  background: var(--color-green-light);
  color: var(--color-green);
}
.tag-gray {
  background: #F5F0EB;
  color: var(--color-text-3);
}
.tag-orange {
  background: #FFF3E8;
  color: var(--color-orange);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--color-text-3);
}
.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-state .empty-text {
  font-size: 28rpx;
  text-align: center;
  line-height: 1.6;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 160rpx;
}

/* Loading 骨架 */
.skeleton {
  background: linear-gradient(90deg, #F5F0EB 25%, #EDE5DC 50%, #F5F0EB 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* 通用入场动画 */
.fade-in {
  animation: fadeIn 0.3s ease both;
}
.slide-up {
  animation: slideUp 0.35s cubic-bezier(0.34, 1.2, 0.64, 1) both;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 底部安全区域 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
