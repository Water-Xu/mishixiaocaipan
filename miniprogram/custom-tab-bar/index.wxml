<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon {{index === 1 ? 'tab-icon-center' : ''}}">
      <text class="tab-emoji">{{item.icon}}</text>
      <view wx:if="{{index === 1}}" class="center-badge"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
